# =============================================
# SpiderChat — Variables de Entorno
# Copiar este archivo como .env y completar
# =============================================

# --- SpiderWebARG API ---
# Clave de acceso a la API (obligatorio)
API_KEY=tu_api_key_aqui

# Nombre de la base de datos en SpiderWebARG
DATABASE_NAME=spiderchat_db

# URL base de la API (no modificar salvo indicacion del soporte)
API_BASE_URL=https://spiderwebargapi.com.ar/api/v1

# --- Servidor ---
PORT=3000

# --- Sesiones ---
# Cadena aleatoria larga para firmar las cookies de sesion
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Limites de usuarios ---
# Tokens totales por usuario (por defecto 50000)
USER_TOKEN_LIMIT=50000

# Llamadas maximas por dia por usuario (por defecto 50)
USER_DAILY_CALL_LIMIT=50
